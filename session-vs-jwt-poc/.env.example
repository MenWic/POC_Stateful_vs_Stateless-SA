# Cada ejecutable aplica su propio puerto e identificador por defecto
APP_PORT=8081
APP_INSTANCE=local-1
DATABASE_PATH=data/poc.db
# Usar true cuando la aplicación se sirva mediante HTTPS
COOKIE_SECURE=false
SESSION_IDLE_TIMEOUT=2m
SESSION_ABSOLUTE_TIMEOUT=10m
# memory conserva sesiones por proceso; redis las comparte entre instancias
SESSION_STORE=memory
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
# JWT_SECRET debe reemplazarse por un valor aleatorio de al menos 32 caracteres
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_ISSUER=session-vs-jwt-poc
JWT_AUDIENCE=session-vs-jwt-web
JWT_TTL=2m
# pure no usa denylist; controlled acepta memory o redis
JWT_SECURITY_MODE=pure
JWT_REVOCATION_STORE=memory
